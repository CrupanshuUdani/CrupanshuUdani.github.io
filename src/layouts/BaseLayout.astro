---
import ThemeScript from "../components/ThemeScript.astro";
import "../styles/global.css";
import { portfolio } from "@shared/portfolio";
import Header from "../components/react/Header";
import Contact from "../components/sections/Contact";
import { getPublishedPosts } from "../lib/writing";

interface Props {
  title: string;
  description: string;
  canonical: string;
  ogImage?: string;
  ogType?: string;
  jsonLd?: Record<string, unknown>;
}

const {
  title,
  description,
  canonical,
  ogImage = portfolio.seo.ogImage,
  ogType = "website",
  jsonLd,
} = Astro.props;

const hasPosts = (await getPublishedPosts()).length > 0;
const navigation = hasPosts
  ? [...portfolio.navigation, { label: "Writing", href: "/writing/" }]
  : portfolio.navigation;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <ThemeScript />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(portfolio.seo.ogImageWidth)} />
    <meta property="og:image:height" content={String(portfolio.seo.ogImageHeight)} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="Crupanshu Udani — Writing" href="/rss.xml" />

    <link rel="preconnect" href="https://api.fontshare.com" />
    <link
      href="https://api.fontshare.com/v2/css?f[]=cabinet-grotesk@500,700,800&f[]=satoshi@400,500,700&display=swap"
      rel="stylesheet"
    />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-md focus:bg-primary focus:px-4 focus:py-3 focus:text-primary-foreground"
      href="#main">Skip to content</a
    >
    <Header navigation={navigation} name={portfolio.profile.name} client:load />
    <slot />
    <Contact portfolio={portfolio} />
    <script
      is:inline
      data-goatcounter="https://crupanshu-github.goatcounter.com/count"
      async
      src="//gc.zgo.at/count.v5.js"
      crossorigin="anonymous"
      integrity="sha384-atnOLvQb9t+jTSipvd75X2yginT4PjVbqDdlJAmxMm+wYElFmeR6EmLP5bYeoRVQ"
    ></script>
  </body>
</html>
