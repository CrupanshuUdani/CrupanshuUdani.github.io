---
import BaseLayout from "../layouts/BaseLayout.astro";
import { portfolio } from "@shared/portfolio";
import {
  AboutSection,
  EducationSection,
  ExperienceSection,
  Hero,
  Impact,
  ProjectsSection,
  SkillsSection,
} from "@/App";

const { profile, seo } = portfolio;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: profile.name,
  url: seo.siteUrl,
  image: seo.ogImage,
  jobTitle: profile.title,
  // Only absolute profile URLs are identities; same-origin files (e.g. a resume PDF) are not.
  sameAs: profile.links.filter((link) => /^https?:\/\//.test(link.href)).map((link) => link.href),
};
---

<BaseLayout title={seo.title} description={seo.description} canonical={seo.siteUrl} jsonLd={jsonLd}>
  <main id="main">
    <Hero portfolio={portfolio} />
    <AboutSection portfolio={portfolio} />
    <Impact portfolio={portfolio} />
    <ExperienceSection experience={portfolio.experience} />
    <ProjectsSection projects={portfolio.projects} />
    <SkillsSection certifications={portfolio.certifications} groups={portfolio.skillGroups} />
    <EducationSection portfolio={portfolio} />
  </main>
</BaseLayout>
