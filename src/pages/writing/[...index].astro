---
// src/pages/writing/[...index].astro
// A rest route whose only possible path is /writing/ itself. getStaticPaths returns no paths
// while there are zero published posts, so the section stays dormant: no page, no sitemap entry.
import BaseLayout from "../../layouts/BaseLayout.astro";
import { portfolio } from "@shared/portfolio";
import { getPublishedPosts } from "../../lib/writing";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.length > 0 ? [{ params: { index: undefined }, props: { posts } }] : [];
}

const { posts } = Astro.props;
const canonical = new URL("/writing/", Astro.site).href;
---

<BaseLayout
  title={`Writing — ${portfolio.profile.name}`}
  description="Field notes and essays on reliability and operations for AI systems, written by someone who carried a pager."
  canonical={canonical}
>
  <main class="mx-auto max-w-4xl px-4 py-16 sm:px-6 lg:px-8" id="main">
    <h1 class="font-display text-4xl font-extrabold tracking-tight">Writing</h1>
    <p class="mt-4 text-lg text-muted-foreground">Reliability and operations for AI systems.</p>
    <ul class="mt-12 space-y-8">
      {
        posts.map((post) => (
          <li class="panel rounded-xl p-6">
            <p class="font-mono text-xs font-bold uppercase tracking-[0.18em] text-muted-foreground">
              <time datetime={post.data.pubDate.toISOString()}>
                {post.data.pubDate.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}
              </time>
              {" · "}
              {post.data.tier.replace("-", " ")}
            </p>
            <h2 class="font-display mt-3 text-2xl font-extrabold tracking-tight">
              <a href={`/writing/${post.id}/`}>{post.data.title}</a>
            </h2>
            <p class="mt-3 text-muted-foreground">{post.data.description}</p>
          </li>
        ))
      }
    </ul>
  </main>
</BaseLayout>
