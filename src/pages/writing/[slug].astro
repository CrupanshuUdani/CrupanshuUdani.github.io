---
// src/pages/writing/[slug].astro
import { render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import "../../styles/prose.css";
import { portfolio } from "@shared/portfolio";
import { getPublishedPosts, formatPostDate } from "../../lib/writing";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const canonical = post.data.canonicalOverride ?? new URL(`/writing/${post.id}/`, Astro.site).href;
const isoPublished = post.data.pubDate.toISOString();

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.description,
  datePublished: isoPublished,
  dateModified: (post.data.updated ?? post.data.pubDate).toISOString(),
  mainEntityOfPage: canonical,
  keywords: post.data.tags.join(", "),
  author: {
    "@type": "Person",
    name: portfolio.profile.name,
    url: portfolio.seo.siteUrl,
  },
};
---

<BaseLayout
  title={`${post.data.title} — ${portfolio.profile.name}`}
  description={post.data.description}
  canonical={canonical}
  ogType="article"
  jsonLd={jsonLd}
>
  <main class="mx-auto max-w-3xl px-4 py-16 sm:px-6 lg:px-8" id="main">
    <nav class="mb-10">
      <a class="font-mono text-xs font-bold uppercase tracking-[0.18em] text-muted-foreground" href="/writing/"
        >← All writing</a
      >
    </nav>
    <article>
      <header class="mb-10">
        <p class="font-mono text-xs font-bold uppercase tracking-[0.18em] text-muted-foreground">
          <time datetime={isoPublished}>
            {formatPostDate(post.data.pubDate)}
          </time>
        </p>
        <h1 class="font-display mt-3 text-4xl font-extrabold tracking-tight">{post.data.title}</h1>
        <p class="mt-4 text-lg text-muted-foreground">{post.data.description}</p>
      </header>
      <div class="prose-site">
        <Content />
      </div>
    </article>
  </main>
</BaseLayout>
