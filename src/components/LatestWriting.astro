---
// src/components/LatestWriting.astro
import { formatPostDate, getPublishedPosts } from "../lib/writing";

const posts = (await getPublishedPosts()).slice(0, 4);
---

{
  posts.length > 0 && (
    <section class="bg-secondary/45 py-20" id="writing">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <p class="font-mono text-xs font-bold uppercase tracking-[0.18em] text-muted-foreground">Writing</p>
        <h2 class="font-display mt-3 text-3xl font-extrabold tracking-tight">
          Notes on reliability, platforms, and the MLOps transition.
        </h2>
        <div class="mt-10 grid gap-5 md:grid-cols-2">
          {posts.map((post) => (
            <article class="panel rounded-xl p-6">
              <p class="font-mono text-xs font-bold uppercase tracking-[0.18em] text-muted-foreground">
                <time datetime={post.data.pubDate.toISOString()}>{formatPostDate(post.data.pubDate)}</time>
              </p>
              <h3 class="font-display mt-3 text-xl font-extrabold tracking-tight">
                <a href={`/writing/${post.id}/`}>{post.data.title}</a>
              </h3>
            </article>
          ))}
        </div>
        <a class="mt-10 inline-block font-mono text-xs font-bold uppercase tracking-[0.18em]" href="/writing/">
          All writing →
        </a>
      </div>
    </section>
  )
}
